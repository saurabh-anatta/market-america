<div class="promo-bar color-{{ section.settings.color_scheme }}">
  <div class="promo-bar__container">
    {%- if section.settings.left_text != blank -%}
      <span class="promo-bar__text">{{ section.settings.left_text | escape }}</span>
    {%- endif -%}

    {%- if section.settings.right_text != blank -%}
      {%- if section.settings.right_link != blank -%}
        <a href="{{ section.settings.right_link }}" class="promo-bar__link">
          {{- section.settings.right_text | escape -}}
        </a>
      {%- else -%}
        <span class="promo-bar__link">{{ section.settings.right_text | escape }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .promo-bar {
    display: flex;
    justify-content: center;
    min-height: 35px;
    padding-inline: 64px;
    background-color: rgb(var(--color-background));
  }

  .promo-bar__container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: var(--page-width);
  }

  .promo-bar__text {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    color: rgb(var(--color-foreground));
    padding-block: 5px;
  }

  .promo-bar__link {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 14px;
    font-weight: 400;
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    padding-block: 1px;
    padding-inline-start: 5px;
  }

  .promo-bar__link:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .promo-bar {
      padding-inline: 12px;
      padding-block: 8px;
      min-height: 32px;
    }

    .promo-bar__container {
      justify-content: center;
    }

    .promo-bar__text {
      font-size: 12px;
      line-height: 16px;
      padding-block: 0;
      text-align: center;
    }

    .promo-bar__link {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.promo_bar",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "left_text",
      "label": "t:settings.left_text",
      "default": "Your Shop Consultant is SHOP.COM"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "t:settings.right_text",
      "default": "Start Your SHOP.COM Business"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "t:settings.right_link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-7"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
