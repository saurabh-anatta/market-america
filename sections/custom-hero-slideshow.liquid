          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:settings.image_mobile"
        },
        {
          "type": "header",
          "content": "t:content.text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Feel Younger. Think Sharper. Age Better"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:settings.subheading",
          "default": "Engineered for fast uptake and cellular support."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.button_label",
          "default": "Start Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:settings.button_link"
        },
        {
          "type": "header",
          "content": "t:content.media"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:settings.overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "select",
          "id": "overlay_gradient_direction",
          "label": "t:settings.overlay_gradient_direction",
          "options": [
            {
              "value": "to left",
              "label": "t:options.to_left"
            },
            {
              "value": "to right",
              "label": "t:options.to_right"
            },
            {
              "value": "to top",
              "label": "t:options.to_top"
            },
            {
              "value": "to bottom",
              "label": "t:options.to_bottom"
            }
          ],
          "default": "to left"
        },
        {
          "type": "select",
          "id": "overlay_gradient_direction_mobile",
          "label": "t:settings.overlay_gradient_direction_mobile",
          "options": [
            {
              "value": "to left",
              "label": "t:options.to_left"
            },
            {
              "value": "to right",
              "label": "t:options.to_right"
            },
            {
              "value": "to top",
              "label": "t:options.to_top"
            },
            {
              "value": "to bottom",
              "label": "t:options.to_bottom"
            }
          ],
          "default": "to bottom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_hero_slideshow",
      "category": "t:categories.banners",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Feel Younger. Think Sharper. Age Better",
            "subheading": "Engineered for fast uptake and cellular support.",
            "button_label": "Start Now",
            "overlay_opacity": 60,
            "overlay_gradient_direction": "to left",
            "overlay_gradient_direction_mobile": "to bottom"
          }
        }
      ]
